# Copy to .env and fill in. NEVER commit .env.

# SQLite database location (created by `uv run python -m app.cli init-db`)
KP_DB_PATH=./kidsproxy.db

# 9router upstream (OpenAI-compatible)
KP_UPSTREAM_BASE_URL=http://host.docker.internal:20128
# Master key stays server-side ONLY; never sent to children's clients.
KP_UPSTREAM_API_KEY=replace-me

# Signing key for parent session cookies. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
KP_SESSION_SECRET=

# Money is integer microdollars (1 USD = 1_000_000).
# Default prices per million tokens (microdollars): $0.50 in / $2.00 out / $0.10 cached-in
KP_PRICE_INPUT_PER_M=500000
KP_PRICE_OUTPUT_PER_M=2000000
KP_PRICE_CACHED_INPUT_PER_M=100000

# Admission threshold: available balance must be >= this to START a request ($1.00)
KP_MIN_START_BALANCE=1000000
# Per-request caps
KP_MAX_OUTPUT_TOKENS=4096
KP_MAX_REQUEST_COST=250000        # $0.25 max charge/reservation per request
KP_MAX_BODY_BYTES=1048576         # 1 MiB request body limit
# Conservative input-token estimate: chars / this value (rounded up)
KP_CHARS_PER_TOKEN_EST=3

# Timeouts (seconds)
KP_UPSTREAM_TIMEOUT=120
KP_STALE_GRACE_SECONDS=300

# Optional global policy (empty = unlimited)
KP_DAILY_LIMIT=                 # e.g. 5000000 = $5/day
KP_MONTHLY_LIMIT=               # e.g. 50000000 = $50/month
KP_ALLOWED_HOURS=               # local-tz window "HH:MM-HH:MM", e.g. 07:00-21:00
KP_TZ=America/Los_Angeles
# Optional model allowlist, comma-separated; empty = all models 9router offers
KP_ALLOWED_MODELS=
# Max simultaneous in-flight requests per child; 0 = unlimited
KP_MAX_CONCURRENT_PER_CHILD=2

# Uncertain-request reconciliation policy:
#   hold    = keep funds reserved until parent runs `cli release-uncertain` (default, safest)
#   release = return reserved funds immediately when usage is unrecoverable
KP_UNCERTAIN_POLICY=hold
